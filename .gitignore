# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Generation outputs (produced by `uv run generate`)
generate/
generate_*/

# Raw downloaded data and processed caches
data/raw/
data/processed/
data/cache/

# Trained model checkpoints — big artifacts stay out EXCEPT the shipped
# inference weights (all under GitHub's 100 MB limit; the validator clones
# the repo and must find them for `uv run generate` to reproduce outputs).
checkpoint/*
!checkpoint/generator/
!checkpoint/generator_blend/
!checkpoint/reward/
!checkpoint/reward_hemo/
checkpoint/generator/*
!checkpoint/generator/config.json
!checkpoint/generator/model.pt
checkpoint/generator_blend/*
!checkpoint/generator_blend/config.json
!checkpoint/generator_blend/model.pt
checkpoint/reward/*
!checkpoint/reward/classifier.pt
!checkpoint/reward/classifier_panel.pt
!checkpoint/reward/config.json
!checkpoint/reward/classifier_config.json
!checkpoint/reward/classifier_panel_config.json
checkpoint/reward_hemo/*
!checkpoint/reward_hemo/classifier.pt
!checkpoint/reward_hemo/config.json
!checkpoint/reward_hemo/classifier_config.json
*.ckpt

# Eval artifacts
eval/
runs/
wandb/
logs/
sweep_results/
sweep_*.log

# Validator clone target (verify_submission default) — NEVER commit a nested repo
submission/

# Notebooks
.ipynb_checkpoints/

# Reference papers (kept locally, not committed — copyrighted)
*.pdf
!AMPChallenge_NeurIPSCompetition.pdf

# Profiling artifacts
profiling/
.zcode/
